# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adaptive_media_rec
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptive_media_rec

# Security
JWT_SECRET=super-secret-jwt-key-change-in-production-adaptive-media-rec
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Reasoning (Anthropic) - Optional: local grounded template engine is active if key is unset
ANTHROPIC_API_KEY=

# External Media APIs (Optional for seeding/enriching)
TMDB_API_KEY=
OMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
